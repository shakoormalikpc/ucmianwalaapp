{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://nwvqyispcoajymwdsixc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "uc-fund-keeper",
      "version": "0.1.0",
      "title": "UC Fund Keeper"
    },
    "tools": [
      {
        "name": "list_members",
        "title": "List members",
        "description": "List members, optionally filtered by name/rafaqat number search text or status. Returns membership and payment totals.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Match against member name or rafaqat number."
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "completed"
              ],
              "description": "Filter by member status."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Max rows to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_member",
        "title": "Get member",
        "description": "Get one member's full record together with their payment history, by member id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "member_id": {
              "type": "string",
              "format": "uuid",
              "description": "The member's id."
            }
          },
          "required": [
            "member_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_payments",
        "title": "List payments",
        "description": "List recorded membership payments, newest first, optionally within a date range.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from_date": {
              "type": "string",
              "description": "Only payments on or after this date (YYYY-MM-DD)."
            },
            "to_date": {
              "type": "string",
              "description": "Only payments on or before this date (YYYY-MM-DD)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Max rows to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "record_payment",
        "title": "Record payment",
        "description": "Record a membership payment for a member. Creates a new payment row.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "member_id": {
              "type": "string",
              "format": "uuid",
              "description": "The member the payment belongs to."
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Payment amount."
            },
            "payment_date": {
              "type": "string",
              "description": "Payment date (YYYY-MM-DD). Defaults to today."
            },
            "payment_method": {
              "type": "string",
              "description": "How the payment was made, e.g. cash or bank."
            },
            "remarks": {
              "type": "string",
              "description": "Optional note about this payment."
            }
          },
          "required": [
            "member_id",
            "amount"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_donations",
        "title": "List fund donations",
        "description": "List fund donations, newest first, optionally within a date range.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from_date": {
              "type": "string",
              "description": "Only donations on or after this date (YYYY-MM-DD)."
            },
            "to_date": {
              "type": "string",
              "description": "Only donations on or before this date (YYYY-MM-DD)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Max rows to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_donation",
        "title": "Add fund donation",
        "description": "Record a new donation into the fund.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "donor_name": {
              "type": "string",
              "minLength": 1,
              "description": "Name of the donor."
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Donated amount."
            },
            "donation_date": {
              "type": "string",
              "description": "Donation date (YYYY-MM-DD). Defaults to today."
            },
            "contact_number": {
              "type": "string",
              "description": "Donor contact number."
            },
            "description": {
              "type": "string",
              "description": "Optional note about this donation."
            }
          },
          "required": [
            "donor_name",
            "amount"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "fund_summary",
        "title": "Fund summary",
        "description": "Summarise the organisation's finances: member counts, total membership payments, donations, expenses and the resulting balance.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from_date": {
              "type": "string",
              "description": "Only count records on or after this date (YYYY-MM-DD)."
            },
            "to_date": {
              "type": "string",
              "description": "Only count records on or before this date (YYYY-MM-DD)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_activities",
        "title": "List activities",
        "description": "List logged organisation activities and announcements, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Max rows to return (default 30)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "log_activity",
        "title": "Log activity",
        "description": "Add an activity or announcement entry to the organisation's activity log.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1,
              "description": "What happened."
            },
            "activity_date": {
              "type": "string",
              "description": "Activity date (YYYY-MM-DD). Defaults to today."
            }
          },
          "required": [
            "message"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
